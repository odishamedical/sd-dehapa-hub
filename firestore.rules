rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /directory/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /doctor_status/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == docId;
    }
    match /consultation_requests/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.patientId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.doctorId);
    }
    match /active_consultations/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
