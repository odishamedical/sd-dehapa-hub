rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /directory/{docId} {
      allow read, write: if true;
    }
    match /outreach_leads/{docId} {
      allow read, write: if true;
    }
    match /whatsapp_debug_logs/{docId} {
      allow read, write: if true;
    }
    match /whatsapp_sessions/{docId} {
      allow read, write: if true;
    }
    match /whatsapp_sessions/{docId}/messages/{msgId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
